---
/**
 * Iconos del proyecto, inlineados desde `/icons/*.svg`.
 *
 * Se inlinean (en vez de usar `<img src>`) para poder teñirlos con
 * `currentColor` y animarlos con GSAP. Los `fill` fijos que traía el export de
 * Figma se han sustituido por `currentColor`; las máscaras, que no aportaban
 * nada sobre un viewBox completo, se han eliminado.
 */
export type IconName =
  | 'arrow-back'
  | 'undo'
  | 'redo'
  | 'sync'
  | 'save'
  | 'record'
  | 'play'
  | 'pause'
  | 'prev'
  | 'next'
  | 'speed'
  | 'text-size'
  | 'teleprompt'
  | 'search'
  | 'video'
  | 'download'
  | 'trash'
  | 'mirror'
  | 'close';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Si se pasa, el icono deja de ser decorativo y se anuncia a lectores. */
  title?: string;
}

const { name, size = 24, class: className = '', title } = Astro.props;

