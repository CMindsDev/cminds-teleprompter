const VIEWBOX: Partial<Record<IconName, string>> = {
  undo: '0 0 12 12',
  redo: '0 0 12 12',
  save: '0 0 29 29',
};
---

<svg
  width={size}
  height={size}
  viewBox={VIEWBOX[name] ?? '0 0 24 24'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  set:html={PATHS[name]}
/>
