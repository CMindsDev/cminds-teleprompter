---
/** Pantalla 6 — Mis grabaciones. */
import Base from '../layouts/Base.astro';
import IconButton from '../components/IconButton.astro';
import LiquidButton from '../components/LiquidButton.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Mis grabaciones · Teleprompter" theme="light">
  <!-- `pb-32` reserva el hueco de la barra fija: la última fila de tarjetas
       tiene que poder subir por encima del botón al hacer scroll. -->
  <main id="library-screen" class="app-shell px-6 pb-32 safe-top">
    <header class="flex items-start justify-between gap-4 py-2" data-anim data-anim-order="0">
      <h1 class="font-display text-[26px] leading-tight font-bold">Mis grabaciones</h1>
      <IconButton id="btn-search" icon="search" label="Buscar" tone="soft" iconSize={18} />
    </header>

    <!-- El buscador aparece solo al pedirlo: la lista manda. -->
    <div id="search-wrap" class="hidden pt-2" data-anim data-anim-order="1">
      <input
        id="search-input"
        type="search"
        placeholder="Buscar por título"
        class="w-full rounded-full border border-line bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none"
      />
    </div>

    <section class="pt-4" data-anim data-anim-order="2">
      <ul id="grid" class="grid grid-cols-2 gap-3"></ul>

      <p id="empty-state" class="hidden pt-16 text-center text-sm leading-relaxed text-ink-soft/70">
        Todavía no tienes grabaciones.<br />Escribe tu primer speech para empezar.
      </p>

      <!-- El gesto es un atajo; la vía accesible es «Eliminar» en el detalle. -->
      <p id="swipe-hint" class="sr-only">
        Arrastra la tarjeta hacia arriba para eliminarla, o ábrela y usa el botón Eliminar.
      </p>
    </section>

  </main>

  <!--
    Barra fija: el botón está siempre a la misma distancia del pulgar, sin
    importar cuántas grabaciones haya. El degradado hacia `paper` evita que las
    tarjetas se corten en seco al pasar por debajo.
  -->
  <div
    class="fixed inset-x-0 bottom-0 z-30 mx-auto w-full max-w-[430px] bg-gradient-to-t from-paper via-paper to-transparent px-6 pt-10 safe-bottom"
    data-anim
    data-anim-order="3"
  >
    <LiquidButton variant="brand" icon="teleprompt" href="/editor" transitionName="cta-principal">
      Nuevo prompt
    </LiquidButton>
  </div>

  <!-- Tarjeta de detalle -->
  <dialog
    id="detail"
    class="m-auto w-[min(92vw,26rem)] rounded-3xl bg-paper p-6 text-ink backdrop:bg-ink/60 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-start justify-between gap-4">
      <h2 id="detail-title" class="font-display text-[20px] leading-tight font-bold"></h2>
      <button
        id="detail-close"
        type="button"
        aria-label="Cerrar"
        class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-ink-soft hover:bg-black/5"
      >
        <Icon name="close" size={20} />
      </button>
    </div>
    <p id="detail-meta" class="mt-1 text-sm text-ink-soft tabular-nums"></p>

    <video
      id="detail-player"
      class="mt-4 aspect-[9/16] max-h-[46vh] w-full rounded-2xl bg-black object-contain"
      controls
      playsinline></video>

    <div class="mt-5 space-y-3">
      <LiquidButton id="detail-download" variant="brand" icon="download">Descargar</LiquidButton>
      <div class="flex gap-3">
        <button
          id="detail-delete"
          type="button"
          class="flex-1 rounded-full border border-line py-3 text-sm font-semibold text-record transition-colors hover:bg-record/5"
        >
          Eliminar
        </button>
        <a
          id="detail-edit"
          href="/editor"
          class="flex-1 rounded-full bg-ink py-3 text-center text-sm font-semibold text-paper transition-opacity hover:opacity-90"
        >
          Editar guion
        </a>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { gsap } from 'gsap';
  import { listRecordings, deleteRecordingMeta, getRecording, saveRecording } from '../lib/store';
  import { deleteBlob, getBlob, listBlobKeys } from '../lib/db';
  import { downloadBlob, extensionFor, formatDuration, slugify } from '../lib/media';
  import { toast } from '../lib/motion';
  import { playFlight, takeFlight } from '../lib/flight';
  import { collapseCard, enableSwipeDelete, type SwipeDeleteHandle } from '../lib/swipe-delete';
  import { maybe, need, onScreen } from '../lib/dom';
  import type { Recording } from '../lib/types';

  onScreen('library-screen', () => {
    const grid = need('grid');
    const emptyState = need('empty-state');
    const dialog = need('detail', HTMLDialogElement);
    const searchWrap = need('search-wrap');
    const searchInput = need('search-input', HTMLInputElement);

    let objectUrl: string | null = null;
    /** Un gesto activo por tarjeta; se rehacen en cada `render`. */
    const swipes: SwipeDeleteHandle[] = [];

    /**
     * Borrado reversible.
     *
     * Los metadatos se quitan al momento (la tarjeta desaparece), pero el vídeo
     * **no se toca** hasta que vence el aviso. Deshacer es entonces devolver la
     * ficha a su sitio, sin haber perdido nada por el camino: un gesto de
     * deslizar se dispara demasiado fácil como para que sea irreversible.
     *
     * Lo comparten el gesto y el botón «Eliminar» del detalle.
     */
    async function removeRecording(id: string, card?: HTMLElement): Promise<void> {
      const recording = getRecording(id);
      if (!recording) return;

      if (card) await collapseCard(card);

      deleteRecordingMeta(id);
      render(searchInput.value, false);

      toast('Grabación eliminada', {
        ms: 5000,
        action: {
          label: 'Deshacer',
          onAction: () => {
            saveRecording(recording);
            render(searchInput.value, false);
          },
        },
        // Nadie lo deshizo: ahora sí se borra el archivo.
        onExpire: () => void deleteBlob(recording.blobKey).catch(() => undefined),
      });
    }

    const formatDate = (ms: number): string =>
      new Date(ms).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });

    /* ── Lista ───────────────────────────────────────────── */

    function cardMarkup(recording: Recording): string {
      return `
        <li>
          <button
            type="button"
            data-id="${recording.id}"
            aria-describedby="swipe-hint"
            class="relative flex aspect-square w-full touch-pan-y flex-col justify-between overflow-hidden rounded-2xl border border-brand-500/60 bg-white p-4 text-left select-none transition-shadow hover:shadow-md focus-visible:shadow-md"
          >
            <span class="relative z-10 flex w-full items-center justify-between text-ink-soft">
              <span class="text-xs font-semibold tabular-nums">${formatDuration(recording.duration)}</span>
              <span class="flex items-center gap-1.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14.2583 20.5332V6.36674H8.8583V3.46674H22.5333V6.36674H17.1333V20.5332H14.2583ZM4.7668 20.5332V11.7332H1.4668V8.80824H10.9583V11.7332H7.6583V20.5332H4.7668Z" fill="currentColor"/>
                </svg>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-brand-500">
                  <path d="M20.54 5.23L19.15 3.55C18.88 3.21 18.47 3 18 3H6C5.53 3 5.12 3.21 4.84 3.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19C3 20.1 3.89 21 5 21H19C20.11 21 21 20.1 21 19V6.5C21 6.02 20.83 5.57 20.54 5.23ZM12 17.5L6.5 12H10V10H14V12H17.5L12 17.5ZM5.12 5L5.93 4H17.93L18.87 5H5.12Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
            <span class="relative z-10 w-full">
              <span class="line-clamp-2 block font-display text-[15px] leading-tight font-bold">${escapeHtml(recording.title)}</span>
              <span class="mt-1 block text-[11px] text-ink-soft/70">${formatDate(recording.createdAt)}</span>
            </span>

            <!-- Relleno de borrado: crece desde abajo con el arrastre. -->
            <span
              data-kill
              class="pointer-events-none absolute inset-x-0 bottom-0 z-20 grid h-0 place-items-center rounded-2xl bg-record text-white opacity-0"
              aria-hidden="true"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                <path d="M7 21C6.45 21 5.97917 20.8042 5.5875 20.4125C5.19583 20.0208 5 19.55 5 19V6H4V4H9V3H15V4H20V6H19V19C19 19.55 18.8042 20.0208 18.4125 20.4125C18.0208 20.8042 17.55 21 17 21H7ZM9 17H11V8H9V17ZM13 17H15V8H13V17Z" fill="currentColor"/>
              </svg>
            </span>
          </button>
        </li>`;
    }

    const NEW_CARD = `
      <li>
        <a
          href="/editor"
          class="grid aspect-square w-full place-items-center rounded-2xl border border-dashed border-line bg-black/[0.02] text-sm text-ink-soft/70 transition-colors hover:border-brand-500 hover:text-brand-500"
        >
          Nuevo speech
        </a>
      </li>`;

    /** Los títulos los escribe el usuario: no se inyectan crudos en el HTML. */
    function escapeHtml(value: string): string {
      const el = document.createElement('span');
      el.textContent = value;
      return el.innerHTML;
    }

    function render(filter = '', animate = true): void {
      const needle = filter.trim().toLowerCase();
      const all = listRecordings();
      const visible = needle ? all.filter((r) => r.title.toLowerCase().includes(needle)) : all;

      // `innerHTML` destruye las tarjetas anteriores: sus listeners se van con
      // ellas, pero los handles quedarían colgando.
      for (const handle of swipes) handle.destroy();
      swipes.length = 0;

      grid.innerHTML = visible.map(cardMarkup).join('') + NEW_CARD;
      emptyState.classList.toggle('hidden', all.length > 0);

      for (const card of grid.querySelectorAll<HTMLElement>('button[data-id]')) {
        swipes.push(
          enableSwipeDelete(card, {
            onArm: (armed) => card.classList.toggle('shadow-lg', armed),
            onConfirm: () => void removeRecording(card.dataset.id ?? '', card),
          }),
        );
      }

      if (animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.from(grid.children, {
          y: 14,
          autoAlpha: 0,
          duration: 0.45,
          ease: 'expo.out',
          stagger: 0.04,
          clearProps: 'all',
        });
      }
    }

    /* ── Buscador ────────────────────────────────────────── */

    maybe('btn-search')?.addEventListener('click', () => {
      const hidden = searchWrap.classList.toggle('hidden');
      if (hidden) {
        searchInput.value = '';
        render();
      } else {
        searchInput.focus();
      }
    });

    searchInput.addEventListener('input', () => render(searchInput.value));

    /* ── Detalle ─────────────────────────────────────────── */

    let current: Recording | null = null;
    let currentBlob: Blob | null = null;

    grid.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-id]');
      if (button?.dataset.id) void openDetail(button.dataset.id);
    });

    async function openDetail(id: string): Promise<void> {
      const recording = getRecording(id);
      if (!recording) return;
      current = recording;

      const titleEl = document.getElementById('detail-title');
      const metaEl = document.getElementById('detail-meta');
      const player = document.getElementById('detail-player');
      const editLink = document.getElementById('detail-edit');

      if (titleEl) titleEl.textContent = recording.title;
      if (metaEl) {
        const megabytes = (recording.size / (1024 * 1024)).toFixed(1);
        metaEl.textContent = `${formatDate(recording.createdAt)} · ${formatDuration(recording.duration)} · ${megabytes} MB`;
      }
      if (editLink instanceof HTMLAnchorElement) editLink.href = `/editor?id=${recording.speechId}`;

      currentBlob = (await getBlob(recording.blobKey)) ?? null;

      if (player instanceof HTMLVideoElement) {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        if (currentBlob) {
          objectUrl = URL.createObjectURL(currentBlob);
          player.src = objectUrl;
          player.classList.remove('hidden');
        } else {
          // El archivo pudo borrarse al limpiar los datos del navegador.
          player.removeAttribute('src');
          player.classList.add('hidden');
          toast('El archivo de vídeo ya no está disponible.', { tone: 'error' });
        }
      }

      dialog.showModal();
    }

    function closeDetail(): void {
      dialog.close();
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
      currentBlob = null;
      current = null;
    }

    maybe('detail-close')?.addEventListener('click', closeDetail);
    dialog.addEventListener('close', () => {
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
    });

    maybe('detail-download')?.addEventListener('click', () => {
      if (!currentBlob || !current) {
        toast('No hay archivo que descargar.', { tone: 'error' });
        return;
      }
      const name = `${slugify(current.title)}-${new Date(current.createdAt).toISOString().slice(0, 10)}.${extensionFor(currentBlob.type)}`;
      downloadBlob(currentBlob, name);
    });

    maybe('detail-delete')?.addEventListener('click', async () => {
      if (!current) return;
      if (!window.confirm(`¿Eliminar "${current.title}"? Esta acción no se puede deshacer.`)) return;

      const { id } = current;
      closeDetail();
      await removeRecording(id);
    });

    /**
     * Vídeos sin ficha que los reclame.
     *
     * Si alguien sale de la pantalla durante los 5 s del aviso, el borrado
     * aplazado nunca llega a ejecutarse y el archivo se queda ocupando sitio.
     * Barrerlo al entrar cubre también los cierres bruscos de pestaña.
     */
    async function sweepOrphanBlobs(): Promise<void> {
      try {
        const alive = new Set(listRecordings().map((r) => r.blobKey));
        const keys = await listBlobKeys();
        await Promise.all(
          keys.filter((key) => !alive.has(key)).map((key) => deleteBlob(key).catch(() => undefined)),
        );
      } catch {
        // IndexedDB no disponible: no es motivo para romper la pantalla.
      }
    }

    void sweepOrphanBlobs();

    /* ── Llegada del clip recién guardado ────────────────── */

    // `takeFlight` consume el dato: si se recarga la página, no se repite.
    const pendingFlight = takeFlight();

    if (pendingFlight) {
      // El vuelo ES la animación de entrada de esta carga. Anulamos la del
      // layout porque desplaza la rejilla, y mediríamos la tarjeta de destino
      // en una posición que no es la definitiva.
      for (const el of document.querySelectorAll('[data-anim]')) {
        el.removeAttribute('data-anim');
        gsap.killTweensOf(el);
        gsap.set(el, { clearProps: 'all' });
      }
    }

    render('', !pendingFlight);

    if (pendingFlight) {
      const target = grid.querySelector<HTMLElement>(`button[data-id="${pendingFlight.id}"]`);
      if (target) void playFlight(pendingFlight, target);
    }
  });
</script>
