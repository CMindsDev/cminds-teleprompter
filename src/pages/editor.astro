---
/**
 * Pantallas 2 y 3 — Editor del guion.
 *
 * Es la misma pantalla en dos estados: vacía (todo gris, CTA desactivado) y
 * con contenido (azul de marca, indicador de guardado). El cambio lo gobierna
 * el script según haya texto o no.
 */
import Base from '../layouts/Base.astro';
import IconButton from '../components/IconButton.astro';
import LiquidButton from '../components/LiquidButton.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Escribe tu speech · Teleprompter" theme="light">
  <!--
    La pantalla no se desplaza: lo que se desplaza es el textarea. Así el botón
    y la barra de deshacer siguen a la vista por largo que sea el speech, sin
    recurrir a `position: fixed` (que el teclado del móvil desplaza o tapa).
  -->
  <main id="editor-screen" class="app-shell h-[var(--app-vh)] overflow-hidden px-6 safe-top safe-bottom">
    <header class="flex shrink-0 items-center justify-between gap-2 py-2" data-anim data-anim-order="0">
      <IconButton icon="arrow-back" label="Volver" href="/" iconSize={24} />

      <div class="flex items-center gap-2">
        <!-- Estado de guardado: gira al guardar, nube azul al terminar. -->
        <span id="save-state" class="grid h-10 w-10 place-items-center text-ink-soft" aria-live="polite">
          <span id="icon-saving" class="hidden text-ink-soft"><Icon name="sync" size={24} /></span>
          <span id="icon-saved" class="hidden text-brand-500"><Icon name="save" size={29} /></span>
          <span id="icon-idle" class="text-ink-soft/70"><Icon name="sync" size={24} /></span>
        </span>

        <IconButton id="btn-undo" icon="undo" label="Deshacer" tone="soft" iconSize={13} disabled />
        <IconButton id="btn-redo" icon="redo" label="Rehacer" tone="soft" iconSize={13} disabled />
      </div>
    </header>

    <div class="flex min-h-0 flex-1 flex-col pt-4" data-anim data-anim-order="1">
      <label for="speech-title" class="sr-only">Título del speech</label>
      <input
        id="speech-title"
        type="text"
        placeholder="Título del speech"
        maxlength="80"
        autocomplete="off"
        class="w-full shrink-0 bg-transparent text-[13px] font-semibold tracking-tight text-ink-soft placeholder:text-ink-soft/55 focus:outline-none"
      />

      <label for="speech-body" class="sr-only">Texto del speech</label>
      <!--
        El textarea es el único que se desplaza. `min-h-0` es imprescindible:
        sin él un hijo flexible se niega a encoger por debajo de su contenido y
        el texto volvería a empujar al botón fuera de la pantalla.
      -->
      <textarea
        id="speech-body"
        placeholder="Comienza a escribir"
        class="mt-3 w-full min-h-0 flex-1 resize-none overflow-y-auto bg-transparent font-display text-[34px] leading-[1.15] font-bold tracking-tight text-ink placeholder:text-muted focus:outline-none"
      ></textarea>

      <p id="word-count" class="shrink-0 pt-3 text-xs text-ink-soft/60 tabular-nums"></p>
    </div>

    <div class="relative shrink-0 pt-4" data-anim data-anim-order="2">
      <!-- Difumina la última línea al pasar tras el botón, en vez de cortarla. -->
      <div
        class="pointer-events-none absolute inset-x-0 -top-6 h-6 bg-gradient-to-t from-paper to-transparent"
        aria-hidden="true"
      >
      </div>
      <LiquidButton id="btn-record" variant="muted" icon="record" disabled transitionName="cta-principal">
        Grabar ahora
      </LiquidButton>
    </div>
  </main>
</Base>

<script>
  import { getSpeech, createSpeech, saveSpeech, setActiveSpeechId } from '../lib/store';
  import { tapFeedback, toast } from '../lib/motion';
  import { maybe, need, onScreen } from '../lib/dom';
  import type { Speech } from '../lib/types';

  /** Historial propio: el nativo del textarea no cubre título + cuerpo juntos. */
  interface Snapshot {
    title: string;
    body: string;
  }

  const HISTORY_LIMIT = 100;
  /** Los cambios seguidos se agrupan: un "deshacer" no borra letra a letra. */
  const COALESCE_MS = 600;
  const SAVE_DEBOUNCE_MS = 700;

  onScreen('editor-screen', () => {
    const titleEl = need('speech-title', HTMLInputElement);
    const bodyEl = need('speech-body', HTMLTextAreaElement);
    const recordBtn = need('btn-record', HTMLButtonElement);
    const undoBtn = need('btn-undo', HTMLButtonElement);
    const redoBtn = need('btn-redo', HTMLButtonElement);
    const wordCount = need('word-count');

    /* ── Carga del guion ─────────────────────────────────── */

    // Sin id se crea un guion vacío; solo un id explícito abre uno existente.
    const editorUrl = new URL(window.location.href);
    const requestedId = editorUrl.searchParams.get('id');
    const speech: Speech = (requestedId ? getSpeech(requestedId) : undefined) ?? createSpeech();
    setActiveSpeechId(speech.id);
    // Recargar o volver a esta entrada del historial conserva este borrador.
    editorUrl.searchParams.set('id', speech.id);
    window.history.replaceState(window.history.state, '', editorUrl);

    // Sobrescribir también los valores que el navegador pudiera restaurar.
    titleEl.value = speech.title;
    bodyEl.value = speech.body;

    /* ── Historial ───────────────────────────────────────── */

    let past: Snapshot[] = [{ title: speech.title, body: speech.body }];
    let future: Snapshot[] = [];
    let lastPush = 0;
    /** Evita que undo/redo se registren a sí mismos como cambios nuevos. */
    let replaying = false;

    const snapshot = (): Snapshot => ({ title: titleEl.value, body: bodyEl.value });

    function pushHistory(): void {
      if (replaying) return;
      const current = snapshot();
      const previous = past[past.length - 1];
      if (previous && previous.title === current.title && previous.body === current.body) return;

      const now = Date.now();
      if (previous && now - lastPush < COALESCE_MS) past[past.length - 1] = current;
      else past.push(current);

      lastPush = now;
      if (past.length > HISTORY_LIMIT) past.shift();
      future = [];
      syncHistoryButtons();
    }

    function apply(state: Snapshot): void {
      replaying = true;
      titleEl.value = state.title;
      bodyEl.value = state.body;
      replaying = false;
      syncUi();
      queueSave();
    }

    function undo(): void {
      if (past.length < 2) return;
      future.push(past.pop()!);
      apply(past[past.length - 1]!);
      syncHistoryButtons();
    }

    function redo(): void {
      const next = future.pop();
      if (!next) return;
      past.push(next);
      apply(next);
      syncHistoryButtons();
    }

    function syncHistoryButtons(): void {
      undoBtn.disabled = past.length < 2;
      redoBtn.disabled = future.length === 0;
    }

    /* ── Guardado ────────────────────────────────────────── */

    const iconIdle = maybe('icon-idle');
    const iconSaving = maybe('icon-saving');
    const iconSaved = maybe('icon-saved');
    let saveTimer = 0;
    let savedTimer = 0;

    function showSaveState(state: 'idle' | 'saving' | 'saved'): void {
      iconIdle?.classList.toggle('hidden', state !== 'idle');
      iconSaving?.classList.toggle('hidden', state !== 'saving');
      iconSaved?.classList.toggle('hidden', state !== 'saved');
      if (state === 'saving') iconSaving?.firstElementChild?.classList.add('animate-spin');
      else iconSaving?.firstElementChild?.classList.remove('animate-spin');
    }

    function queueSave(): void {
      window.clearTimeout(saveTimer);
      window.clearTimeout(savedTimer);
      if (!titleEl.value.trim() && !bodyEl.value.trim()) {
        showSaveState('idle');
        return;
      }
      showSaveState('saving');
      saveTimer = window.setTimeout(() => {
        const ok = saveSpeech({ ...speech, title: titleEl.value, body: bodyEl.value });
        if (!ok) {
          showSaveState('idle');
          toast('No pudimos guardar: almacenamiento lleno.', { tone: 'error' });
          return;
        }
        showSaveState('saved');
        // Pasados unos segundos volvemos al icono neutro: la nube azul es una
        // confirmación puntual, no un estado permanente.
        savedTimer = window.setTimeout(() => showSaveState('idle'), 4000);
      }, SAVE_DEBOUNCE_MS);
    }

    /* ── Interfaz reactiva ───────────────────────────────── */

    function syncUi(): void {
      const hasText = bodyEl.value.trim().length > 0;

      recordBtn.classList.toggle('bg-muted', !hasText);
      recordBtn.classList.toggle('text-white/90', !hasText);
      recordBtn.classList.toggle('bg-brand-500', hasText);
      recordBtn.classList.toggle('text-white', hasText);
      recordBtn.classList.toggle('shadow-lg', hasText);
      recordBtn.classList.toggle('shadow-brand-500/25', hasText);

      recordBtn.disabled = !hasText;
      recordBtn.setAttribute('aria-disabled', String(!hasText));

      const words = bodyEl.value.trim() ? bodyEl.value.trim().split(/\s+/).length : 0;
      // ~130 palabras por minuto es un ritmo de lectura hablada cómodo.
      const seconds = Math.round((words / 130) * 60);
      wordCount.textContent = words
        ? `${words} palabras · ~${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')} de lectura`
        : '';
    }

    /* ── Eventos ─────────────────────────────────────────── */

    for (const field of [titleEl, bodyEl]) {
      field.addEventListener('input', () => {
        syncUi();
        pushHistory();
        queueSave();
      });
    }

    undoBtn.addEventListener('click', undo);
    redoBtn.addEventListener('click', redo);

    document.addEventListener('keydown', (event) => {
      if (!(event.metaKey || event.ctrlKey)) return;
      const key = event.key.toLowerCase();
      if (key === 'z' && !event.shiftKey) {
        event.preventDefault();
        undo();
      } else if ((key === 'z' && event.shiftKey) || key === 'y') {
        event.preventDefault();
        redo();
      }
    });

    recordBtn.addEventListener('click', (event) => {
      if (!bodyEl.value.trim()) {
        event.preventDefault();
        return;
      }
      // Guardamos de inmediato: la pantalla de grabación lee de localStorage.
      window.clearTimeout(saveTimer);
      saveSpeech({ ...speech, title: titleEl.value, body: bodyEl.value });
      tapFeedback(recordBtn);
      window.location.href = `/grabar?id=${speech.id}`;
    });

    // Cerrar la pestaña a mitad de una frase no debería perder el texto.
    window.addEventListener('pagehide', () => {
      window.clearTimeout(saveTimer);
      if (titleEl.value.trim() || bodyEl.value.trim()) {
        saveSpeech({ ...speech, title: titleEl.value, body: bodyEl.value });
      }
    });

    syncUi();
    syncHistoryButtons();

    if (!bodyEl.value) bodyEl.focus();
  });
</script>
