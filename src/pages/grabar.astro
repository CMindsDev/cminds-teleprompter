---
/**
 * Pantallas 4 y 5 — Cámara y grabación con teleprompter.
 *
 * Tres estados sobre el mismo vídeo en vivo:
 *   preview    → encuadre, botón "Iniciar grabación"
 *   recording  → cronómetro, texto desplazándose, barra de controles
 *   review     → el clip a pantalla completa: verlo, repetirlo o guardarlo
 */
import Base from '../layouts/Base.astro';
import IconButton from '../components/IconButton.astro';
import LiquidButton from '../components/LiquidButton.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Grabar · Teleprompter" theme="video" lockScroll>
  <!--
    `--capture-aspect` es la única definición del formato: lo comparten el
    encuadre, la revisión y el lienzo de composición. El futuro selector solo
    tendrá que cambiar esta variable y el formato que se pasa a `media.ts`.

    En escritorio el lienzo se ensancha: una webcam es apaisada y a 430 px el
    encuadre quedaba en una franja diminuta dentro de una columna muy alta.
  -->
  <main
    class="app-shell relative overflow-hidden bg-black lg:max-w-[560px]"
    style="--capture-aspect: 9 / 16"
    data-state="preview"
    id="stage"
  >
    <!--
      Marco de captura: siempre vertical, lo dé la cámara en vertical o no.
      `object-cover` lo llena recortando al centro, y `composeVertical` aplica
      ese mismo recorte al archivo, así que lo que se ve es lo que se graba.
    -->
    <div id="capture-frame" class="absolute inset-0 m-auto aspect-[var(--capture-aspect)] max-h-full max-w-full">
      <!-- `scale-x-[-1]` refleja la vista previa, no el archivo grabado. -->
      <video
        id="camera"
        class="h-full w-full scale-x-[-1] object-cover"
        playsinline
        autoplay
        muted></video>
    </div>

    <!-- Diagnóstico de dispositivo: se activa con `/grabar?debug=1`. -->
    <p
      id="debug-readout"
      class="pointer-events-none absolute inset-x-0 top-20 z-40 hidden px-4 text-center font-mono text-[11px] leading-relaxed text-white/80"
    >
    </p>

    <!-- Degradados: mantienen legibles los controles sobre cualquier encuadre. -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/55 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-black/70 to-transparent"
      aria-hidden="true"
    >
    </div>

    <!-- ── Barra superior ─────────────────────────────────── -->
    <header
      id="stage-header"
      class="relative z-20 flex items-center justify-between px-6 safe-top"
      data-anim
      data-anim-order="0"
    >
      <IconButton
        id="btn-exit"
        icon="arrow-back"
        label="Volver al editor"
        iconSize={24}
        class="text-white hover:bg-white/15"
      />

      <!-- Cronómetro: solo visible mientras se graba. -->
      <div id="timer-wrap" class="hidden items-center gap-2" aria-live="off">
        <span id="rec-dot" class="h-2.5 w-2.5 rounded-full bg-record"></span>
        <span id="timer" class="font-display text-[17px] font-semibold tabular-nums text-white">00:00</span>
      </div>

      <div class="flex items-center gap-2">
        <IconButton
          id="btn-mirror"
          icon="mirror"
          label="Espejo del texto"
          iconSize={20}
          class="hidden text-white hover:bg-white/15"
        />
        <a
          id="btn-edit"
          href="/editor"
          class="rounded-full border border-white/45 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:bg-white/15"
        >
          Editar
        </a>
      </div>
    </header>

    <!-- ── Teleprompter ───────────────────────────────────── -->
    <!--
      El viewport se coloca sobre la mitad inferior del encuadre: así el texto
      queda cerca de la cámara y la mirada no se desvía tanto. `mask-image`
      difumina los bordes para que las líneas entren y salgan sin corte.
    -->
    <section
      id="prompter-viewport"
      class="absolute inset-x-0 bottom-[8.5rem] top-[42%] z-10 hidden overflow-hidden px-7"
      style="mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 62%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 62%, transparent 100%)"
      aria-hidden="true"
    >
      <div
        id="prompter-track"
        class="font-display font-bold tracking-tight whitespace-pre-wrap text-white will-change-transform"
        style="text-shadow: 0 2px 14px rgba(0,0,0,0.6)"
      >
      </div>
    </section>

    <!-- Progreso de lectura -->
    <div id="progress-rail" class="absolute inset-x-6 bottom-[7.25rem] z-20 hidden h-[3px] rounded-full bg-white/20">
      <div id="progress-bar" class="h-full w-0 rounded-full bg-brand-500 transition-[width] duration-150"></div>
    </div>

    <!-- ── Controles inferiores ───────────────────────────── -->
    <footer class="relative z-20 mt-auto px-6 pb-2 safe-bottom">
      <!--
        Ajustes del prompter. Viven fuera de los grupos de estado porque están
        disponibles tanto al encuadrar como al grabar: se ajusta antes de
        empezar y se corrige sobre la marcha sin cambiar de gesto.
        La altura fija reserva el sitio para que abrir un slider no empuje
        la fila de botones.
      -->
      <div class="relative h-12">
        <p
          id="slider-readout"
          class="pointer-events-none absolute inset-x-0 -top-7 hidden text-center text-xs font-semibold text-white/80 tabular-nums"
          aria-hidden="true"
        >
        </p>

        <!-- Velocidad: regla horizontal -->
        <div id="speed-slider" class="absolute inset-x-1 bottom-0 hidden"></div>

        <!-- Tamaño de texto: barra vertical que crece hacia arriba -->
        <div id="size-slider" class="absolute right-3 bottom-0 hidden"></div>
      </div>

      <!-- Estado preview -->
      <div id="controls-preview" data-anim data-anim-order="1">
        <div class="flex items-center justify-between px-2 pt-1">
          <button
            id="btn-speed"
            type="button"
            class="grid h-11 w-11 place-items-center rounded-full text-white transition-colors hover:bg-white/10"
            aria-label="Velocidad del teleprompter"
            aria-expanded="false"
          >
            <Icon name="speed" size={24} />
          </button>

          <button
            id="btn-start"
            type="button"
            class="grid h-[62px] w-[62px] place-items-center rounded-full bg-record text-white shadow-lg shadow-record/40 transition-transform duration-200 hover:scale-105 active:scale-95"
            aria-label="Iniciar grabación"
            transition:name="cta-principal"
          >
            <Icon name="record" size={30} />
          </button>

          <button
            id="btn-textsize"
            type="button"
            class="grid h-11 w-11 place-items-center rounded-full text-white transition-colors hover:bg-white/10"
            aria-label="Tamaño del texto"
            aria-expanded="false"
          >
            <Icon name="text-size" size={24} />
          </button>
        </div>
      </div>

      <!-- Estado recording -->
      <div id="controls-recording" class="hidden">
        <div class="flex items-center justify-between gap-1 px-1 pt-1">
          <button
            id="btn-speed-rec"
            type="button"
            class="grid h-11 w-11 place-items-center rounded-full text-white transition-colors hover:bg-white/10"
            aria-label="Velocidad del teleprompter"
            aria-expanded="false"
          >
            <Icon name="speed" size={24} />
          </button>

          <IconButton
            id="btn-prev"
            icon="prev"
            label="Retroceder texto"
            size={44}
            iconSize={24}
            class="text-white hover:bg-white/15"
          />

          <button
            id="btn-stop"
            type="button"
            class="grid h-[62px] w-[62px] place-items-center rounded-full bg-record text-white shadow-lg shadow-record/40 transition-transform duration-200 hover:scale-105 active:scale-95"
            aria-label="Detener la grabación"
          >
            <span class="block h-[22px] w-[22px] rounded-[5px] bg-white"></span>
          </button>

          <IconButton
            id="btn-next"
            icon="next"
            label="Avanzar texto"
            size={44}
            iconSize={24}
            class="text-white hover:bg-white/15"
          />

          <button
            id="btn-textsize-rec"
            type="button"
            class="grid h-11 w-11 place-items-center rounded-full text-white transition-colors hover:bg-white/10"
            aria-label="Tamaño del texto"
            aria-expanded="false"
          >
            <Icon name="text-size" size={24} />
          </button>
        </div>

        <!-- Play/pausa del texto: separado del botón rojo para no confundir
             "pausar la lectura" con "detener la grabación". -->
        <div class="flex justify-center pt-3">
          <button
            id="btn-play"
            type="button"
            data-liquid="onVideo"
            class="liquid flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white"
            aria-label="Reproducir teleprompter"
            aria-pressed="false"
          >
            <span id="icon-play" class="relative z-10 translate-x-[1px]"><Icon name="play" size={18} /></span>
            <span id="icon-pause" class="relative z-10 hidden"><Icon name="pause" size={18} /></span>
            <span id="play-label" class="relative z-10">Reanudar texto</span>
          </button>
        </div>
      </div>
    </footer>

    <!-- ── Revisión del clip ──────────────────────────────── -->
    <!--
      Ocupa toda la pantalla, como el encuadre: la toma se revisa al mismo
      tamaño con el que se grabó, no dentro de una ventanita.
    -->
    <section
      id="review-layer"
      class="absolute inset-0 z-30 hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Revisar la grabación"
    >
      <!-- Mismo marco que el encuadre: la revisión enseña lo que se grabó. -->
      <div class="absolute inset-0 m-auto aspect-[var(--capture-aspect)] max-h-full max-w-full">
        <video id="review-player" class="h-full w-full bg-black object-contain" playsinline></video>
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/55 to-transparent"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-black/70 to-transparent"
        aria-hidden="true"
      >
      </div>

      <header class="relative z-10 flex items-center justify-between px-6 safe-top">
        <IconButton
          id="btn-discard"
          icon="arrow-back"
          label="Descartar la toma"
          iconSize={24}
          class="text-white hover:bg-white/15"
        />

        <span id="review-duration" class="font-display text-[17px] font-semibold tabular-nums text-white">00:00</span>

        <button
          id="btn-replay"
          type="button"
          class="rounded-full border border-white/45 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:bg-white/15"
        >
          Repetir
        </button>
      </header>

      <footer class="absolute inset-x-0 bottom-0 z-10 px-6 pb-2 safe-bottom">
        <LiquidButton id="btn-save" variant="brand" icon="archive">Guardar video</LiquidButton>
      </footer>
    </section>

    <!-- ── Error de permisos ──────────────────────────────── -->
    <section
      id="permission-error"
      class="absolute inset-0 z-40 hidden place-items-center bg-ink/95 px-8 text-center backdrop-blur-sm"
    >
      <div class="max-w-xs">
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-white/10 text-white">
          <Icon name="video" size={26} />
        </div>
        <h2 class="mt-5 font-display text-[22px] font-bold text-white">No pudimos abrir la cámara</h2>
        <p id="permission-message" class="mt-2 text-sm leading-relaxed text-white/70"></p>
        <div class="mt-7 space-y-3">
          <LiquidButton id="btn-retry" variant="brand">Reintentar</LiquidButton>
          <a href="/editor" class="block text-sm font-medium text-white/60 hover:text-white">Volver al editor</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { gsap } from 'gsap';
  import { Teleprompter } from '../lib/teleprompter';
  import {
    downloadBlob,
    extensionFor,
    formatDuration,
    requestCamera,
    slugify,
    startRecording,
    stopStream,
    composeVertical,
    describeStream,
    type Composer,
    CAPTURE_FORMATS,
    DEFAULT_FORMAT,
    MediaError,
    type RecorderHandle,
  } from '../lib/media';
  import { getActiveSpeechId, getSpeech, newId, saveRecording, updateSettings } from '../lib/store';
  import { deleteBlob, putBlob } from '../lib/db';
  import { captureFrame, rectOf, stashFlight } from '../lib/flight';
  import { pulse, tapFeedback, toast } from '../lib/motion';
  import { FONT_SIZE_RANGE, SPEED_RANGE } from '../lib/types';
  import { Slider } from '../lib/slider';
  import { maybe, need, onScreen } from '../lib/dom';

  onScreen('stage', () => {
    const stage = need('stage');
    const video = need('camera', HTMLVideoElement);
    const viewport = need('prompter-viewport');
    const track = need('prompter-track');
    const controlsPreview = need('controls-preview');
    const controlsRecording = need('controls-recording');
    const timerWrap = need('timer-wrap');
    const timerEl = need('timer');
    const progressRail = need('progress-rail');
    const progressBar = need('progress-bar');
    const stageHeader = need('stage-header');
    const reviewLayer = need('review-layer');
    const reviewPlayer = need('review-player', HTMLVideoElement);
    const reviewDuration = need('review-duration');
    const errorPanel = need('permission-error');

    /* ── Guion ───────────────────────────────────────────── */

    const requestedId = new URL(window.location.href).searchParams.get('id') ?? getActiveSpeechId();
    const loaded = requestedId ? getSpeech(requestedId) : undefined;

    if (!loaded || !loaded.body.trim()) {
      // Sin guion no hay nada que leer: volvemos al editor en vez de mostrar
      // una cámara vacía.
      window.location.replace('/editor');
      return;
    }
    const speech = loaded;

    track.textContent = speech.body;
    const editLink = maybe('btn-edit', HTMLAnchorElement);
    if (editLink) editLink.href = `/editor?id=${speech.id}`;

    const iconPlay = need('icon-play');
    const iconPause = need('icon-pause');
    const playBtn = need('btn-play', HTMLButtonElement);
    const playLabel = need('play-label');

    const prompter = new Teleprompter(viewport, track, { ...speech.settings }, {
      onProgress: (ratio) => {
        progressBar.style.width = `${ratio * 100}%`;
      },
      onEnd: () => toast('Llegaste al final del guion'),
      onStateChange: (playing) => {
        iconPlay.classList.toggle('hidden', playing);
        iconPause.classList.toggle('hidden', !playing);
        playLabel.textContent = playing ? 'Pausar texto' : 'Reanudar texto';
        playBtn.setAttribute('aria-pressed', String(playing));
        playBtn.setAttribute('aria-label', playing ? 'Pausar teleprompter' : 'Reproducir teleprompter');
      },
    });

    /* ── Cámara ──────────────────────────────────────────── */

    let stream: MediaStream | null = null;
    let recorder: RecorderHandle | null = null;
    /** Lienzo que recompone la cámara al formato pedido mientras se graba. */
    let composer: Composer | null = null;
    let startedAt = 0;
    let timerId = 0;
    let pulseTween: gsap.core.Tween | null = null;
    /** Toma pendiente de guardar. Mientras no sea `null`, salir la pierde. */
    let lastBlob: Blob | null = null;
    let lastDuration = 0;
    let objectUrl: string | null = null;
    /** Evita guardar dos veces si se toca el botón repetidamente. */
    let saving = false;

    async function openCamera(): Promise<void> {
      try {
        stream = await requestCamera({ facingMode: 'user', audio: true, format: DEFAULT_FORMAT });
        video.srcObject = stream;
        await video.play().catch(() => {
          /* Algunos navegadores exigen gesto del usuario; el autoplay muted suele bastar. */
        });
        errorPanel.classList.add('hidden');
        errorPanel.classList.remove('grid');
      } catch (error) {
        const message =
          error instanceof MediaError ? error.message : 'No pudimos iniciar la cámara. Inténtalo de nuevo.';
        const target = maybe('permission-message');
        if (target) target.textContent = message;
        errorPanel.classList.remove('hidden');
        errorPanel.classList.add('grid');
      }
    }

    maybe('btn-retry')?.addEventListener('click', () => void openCamera());
    void openCamera();

    /* ── Diagnóstico de dispositivo ──────────────────────── */

    // `?debug=1` enseña qué entrega la cámara y a qué se compone. Sirve para
    // responder «¿por qué se ve así?» en un móvil concreto, donde no hay consola.
    if (new URL(window.location.href).searchParams.get('debug') === '1') {
      const readout = maybe('debug-readout');
      if (readout) {
        readout.classList.remove('hidden');
        const { width, height } = CAPTURE_FORMATS[DEFAULT_FORMAT];
        const refresh = (): void => {
          readout.textContent = stream
            ? `${describeStream(stream, video)} · salida ${width}×${height}`
            : 'sin cámara';
        };
        video.addEventListener('loadedmetadata', refresh);
        video.addEventListener('resize', refresh);
        window.setInterval(refresh, 1000);
      }
    }

    /* ── Cambio de estado ────────────────────────────────── */

    function setState(state: 'preview' | 'recording' | 'review'): void {
      stage.dataset.state = state;

      // En revisión manda la capa del clip: la barra y los controles del
      // encuadre desaparecen para no competir con ella.
      stageHeader.classList.toggle('hidden', state === 'review');
      reviewLayer.classList.toggle('hidden', state !== 'review');

      controlsPreview.classList.toggle('hidden', state !== 'preview');
      controlsRecording.classList.toggle('hidden', state !== 'recording');
      viewport.classList.toggle('hidden', state !== 'recording');
      viewport.classList.remove('opacity-45');
      progressRail?.classList.toggle('hidden', state !== 'recording');
      maybe('btn-mirror')?.classList.toggle('hidden', state !== 'recording');

      timerWrap?.classList.toggle('hidden', state !== 'recording');
      timerWrap?.classList.toggle('flex', state === 'recording');

      // Un panel de ajustes abierto no debe sobrevivir al cambio de estado:
      // taparía el encuadre o la hoja de revisión. (`showPanel` se declara más
      // abajo; la declaración de función está izada y setState solo se invoca
      // una vez montado todo.)
      showPanel(null);

      // El texto del teleprompter es decorativo para lectores de pantalla
      // mientras no se está grabando.
      viewport.setAttribute('aria-hidden', state === 'recording' ? 'false' : 'true');
    }

    /* ── Grabación ───────────────────────────────────────── */

    function tickTimer(): void {
      lastDuration = Date.now() - startedAt;
      timerEl.textContent = formatDuration(lastDuration);
    }

    async function start(): Promise<void> {
      if (!stream) {
        await openCamera();
        if (!stream) return;
      }

      // Se graba el lienzo compuesto, no la cámara en crudo: es lo que asegura
      // un archivo de 1080×1920 aunque el sensor entregue apaisado. Si el
      // navegador no sabe capturar un lienzo, se graba la pista original.
      composer = composeVertical(video, stream, DEFAULT_FORMAT);
      if (!composer) toast('Este navegador grabará en el formato de la cámara.', { tone: 'error' });

      try {
        recorder = startRecording(composer?.stream ?? stream);
      } catch (error) {
        composer?.stop();
        composer = null;
        toast(error instanceof Error ? error.message : 'No se pudo grabar.', { tone: 'error' });
        return;
      }

      startedAt = Date.now();
      lastDuration = 0;
      timerEl.textContent = '00:00';
      timerId = window.setInterval(tickTimer, 250);

      const dot = maybe('rec-dot');
      if (dot) pulseTween = pulse(dot);

      setState('recording');
      prompter.restart();
      // Un respiro antes de arrancar el texto: da tiempo a encuadrarse y respirar.
      window.setTimeout(() => prompter.play(), 900);
    }

    async function stop(): Promise<void> {
      if (!recorder) return;

      prompter.pause();
      window.clearInterval(timerId);
      pulseTween?.kill();
      pulseTween = null;

      const duration = lastDuration;
      let blob: Blob;
      try {
        blob = await recorder.stop();
      } catch (error) {
        composer?.stop();
        composer = null;
        toast(error instanceof Error ? error.message : 'La grabación falló.', { tone: 'error' });
        setState('preview');
        return;
      }
      recorder = null;
      composer?.stop();
      composer = null;
      lastBlob = blob;

      // Guardamos los ajustes del prompter: la próxima toma arranca igual.
      // La grabación en sí NO se persiste todavía: eso lo decide el usuario en
      // la pantalla de revisión, o «Guardar video» no significaría nada.
      updateSettings(speech.id, prompter.current);

      showReview(blob, duration);
    }

    /* ── Revisión ────────────────────────────────────────── */

    function showReview(blob: Blob, duration: number): void {
      setState('review');

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(blob);
      reviewPlayer.src = objectUrl;
      reviewPlayer.currentTime = 0;
      void reviewPlayer.play().catch(() => {
        /* Si el navegador bloquea la reproducción, «Repetir» la arranca. */
      });

      reviewDuration.textContent = formatDuration(duration);

      // `setState` ya mostró la capa; aquí solo la hacemos entrar.
      gsap.from(reviewLayer, { autoAlpha: 0, duration: 0.35, ease: 'power2.out' });
    }

    /** Tocar el vídeo pausa o reanuda: sin controles nativos encima del clip. */
    reviewPlayer.addEventListener('click', () => {
      reviewPlayer.paused ? void reviewPlayer.play() : reviewPlayer.pause();
    });

    maybe('btn-replay')?.addEventListener('click', () => {
      reviewPlayer.currentTime = 0;
      void reviewPlayer.play();
    });

    function discardTake(): void {
      lastBlob = null;
      reviewPlayer.pause();
      reviewPlayer.removeAttribute('src');
      reviewPlayer.load();
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
      setState('preview'); // oculta la capa de revisión
      prompter.restart();
    }

    maybe('btn-discard')?.addEventListener('click', () => {
      if (!window.confirm('¿Descartar esta toma? No se guardará.')) return;
      discardTake();
    });

    /* ── Guardar ─────────────────────────────────────────── */

    async function save(): Promise<void> {
      const blob = lastBlob;
      if (!blob || saving) return;
      saving = true;

      const recordingId = newId();
      const blobKey = `rec-${recordingId}`;

      try {
        await putBlob(blobKey, blob);
      } catch {
        // IndexedDB llena o bloqueada. La toma sigue en memoria, así que
        // ofrecemos descargarla antes de perderla.
        saving = false;
        toast('Sin espacio para guardarla. Descargando el archivo…', { tone: 'error' });
        const name = `${slugify(speech.title || 'speech')}-${new Date().toISOString().slice(0, 10)}.${extensionFor(blob.type)}`;
        downloadBlob(blob, name);
        return;
      }

      const ok = saveRecording({
        id: recordingId,
        speechId: speech.id,
        title: speech.title || 'Speech sin título',
        createdAt: Date.now(),
        duration: lastDuration,
        mimeType: blob.type,
        size: blob.size,
        blobKey,
      });

      if (!ok) {
        await deleteBlob(blobKey).catch(() => undefined);
        saving = false;
        toast('No pudimos guardar la grabación.', { tone: 'error' });
        return;
      }

      // El vuelo se reproduce en «Mis grabaciones», que es donde se puede medir
      // la tarjeta de destino. Aquí solo dejamos el fotograma y el punto de
      // partida; si algo falla, la navegación ocurre igual, sin animación.
      const frame = captureFrame(reviewPlayer);
      if (frame) {
        stashFlight({ id: recordingId, image: frame, from: rectOf(reviewPlayer) });
      }

      lastBlob = null; // ya persistida: el aviso de salida deja de aplicar
      window.location.href = '/grabaciones';
    }

    maybe('btn-save')?.addEventListener('click', (event) => {
      tapFeedback(event.currentTarget as Element);
      void save();
    });

    // Una toma sin guardar se pierde al cerrar la pestaña: hay que avisar.
    window.addEventListener('beforeunload', (event) => {
      if (!lastBlob) return;
      event.preventDefault();
      // `returnValue` está obsoleto pero sigue siendo lo que Chrome exige para
      // mostrar el aviso; `preventDefault()` solo basta en Firefox y Safari.
      event.returnValue = '';
    });

    /* ── Controles ───────────────────────────────────────── */

    maybe('btn-start')?.addEventListener('click', (event) => {
      tapFeedback(event.currentTarget as Element);
      void start();
    });

    maybe('btn-stop')?.addEventListener('click', (event) => {
      tapFeedback(event.currentTarget as Element);
      void stop();
    });

    maybe('btn-play')?.addEventListener('click', () => prompter.toggle());
    maybe('btn-prev')?.addEventListener('click', () => prompter.step(-1));
    maybe('btn-next')?.addEventListener('click', () => prompter.step(1));

    /* ── Ajustes: velocidad y tamaño ─────────────────────── */

    const readout = need('slider-readout');
    const speedPanel = need('speed-slider');
    const sizePanel = need('size-slider');

    // Los mismos dos sliders sirven al encuadrar y al grabar, así que cada uno
    // tiene un disparador por estado apuntando al mismo panel.
    const speedTriggers = [maybe('btn-speed'), maybe('btn-speed-rec')].filter(
      (el): el is HTMLElement => el !== null,
    );
    const sizeTriggers = [maybe('btn-textsize'), maybe('btn-textsize-rec')].filter(
      (el): el is HTMLElement => el !== null,
    );

    /** La velocidad se muestra como multiplicador: 40 px/s es el ritmo base. */
    const speedText = (value: number): string => `${(value / 40).toFixed(1)}×`;

    const speedSlider = new Slider(speedPanel, {
      variant: 'ticks',
      min: SPEED_RANGE.min,
      max: SPEED_RANGE.max,
      step: SPEED_RANGE.step,
      value: prompter.current.speed,
      label: 'Velocidad del teleprompter',
      format: speedText,
      onInput: (value) => {
        prompter.setSpeed(value);
        readout.textContent = `Velocidad ${speedText(value)}`;
      },
      onCommit: () => updateSettings(speech.id, prompter.current),
    });

    const sizeSlider = new Slider(sizePanel, {
      variant: 'fill',
      min: FONT_SIZE_RANGE.min,
      max: FONT_SIZE_RANGE.max,
      step: FONT_SIZE_RANGE.step,
      value: prompter.current.fontSize,
      label: 'Tamaño del texto',
      format: (value) => `${value} px`,
      onInput: (value) => {
        prompter.setFontSize(value);
        readout.textContent = `Texto ${value} px`;
      },
      onCommit: () => updateSettings(speech.id, prompter.current),
    });

    type PanelName = 'speed' | 'size' | null;
    let openPanel: PanelName = null;
    let autoCloseTimer = 0;

    function showPanel(name: PanelName): void {
      window.clearTimeout(autoCloseTimer);
      openPanel = name;

      speedPanel.classList.toggle('hidden', name !== 'speed');
      sizePanel.classList.toggle('hidden', name !== 'size');
      readout.classList.toggle('hidden', name === null);

      for (const trigger of speedTriggers) {
        trigger.setAttribute('aria-expanded', String(name === 'speed'));
        trigger.classList.toggle('bg-white/20', name === 'speed');
      }
      for (const trigger of sizeTriggers) {
        trigger.setAttribute('aria-expanded', String(name === 'size'));
        trigger.classList.toggle('bg-white/20', name === 'size');
      }

      if (name === 'speed') readout.textContent = `Velocidad ${speedSlider.text}`;
      if (name === 'size') readout.textContent = `Texto ${sizeSlider.text}`;

      // Al encuadrar el texto está oculto: lo mostramos atenuado mientras se
      // ajusta para que el cambio de tamaño y ritmo se pueda juzgar de verdad.
      const previewing = name !== null && stage.dataset.state === 'preview';
      viewport.classList.toggle('hidden', !previewing && stage.dataset.state !== 'recording');
      viewport.classList.toggle('opacity-45', previewing);

      if (name !== null) {
        // Se cierra solo: dejarlo abierto tapa el encuadre.
        autoCloseTimer = window.setTimeout(() => showPanel(null), 4500);
      }
    }

    /** Refleja en los sliders los cambios hechos por teclado. */
    function syncSliders(): void {
      speedSlider.sync(prompter.current.speed);
      sizeSlider.sync(prompter.current.fontSize);
      if (openPanel === 'speed') readout.textContent = `Velocidad ${speedSlider.text}`;
      if (openPanel === 'size') readout.textContent = `Texto ${sizeSlider.text}`;
    }

    for (const trigger of speedTriggers) {
      trigger.addEventListener('click', () => showPanel(openPanel === 'speed' ? null : 'speed'));
    }
    for (const trigger of sizeTriggers) {
      trigger.addEventListener('click', () => showPanel(openPanel === 'size' ? null : 'size'));
    }

    // Cualquier toque fuera de los paneles los cierra.
    stage.addEventListener('pointerdown', (event) => {
      if (openPanel === null) return;
      const target = event.target as HTMLElement;
      if (target.closest('#speed-slider, #size-slider, [aria-expanded]')) return;
      showPanel(null);
    });

    maybe('btn-mirror')?.addEventListener('click', (event) => {
      const mirrored = !prompter.current.mirrored;
      prompter.setMirrored(mirrored);
      (event.currentTarget as HTMLElement).classList.toggle('bg-white/20', mirrored);
    });

    maybe('btn-exit')?.addEventListener('click', () => {
      if (recorder) {
        const leave = window.confirm('Estás grabando. ¿Seguro que quieres salir? Se perderá la toma.');
        if (!leave) return;
      }
      window.location.href = `/editor?id=${speech.id}`;
    });

    /* ── Atajos de teclado ───────────────────────────────── */

    document.addEventListener('keydown', (event) => {
      const state = stage.dataset.state;
      // Velocidad y tamaño se ajustan también al encuadrar; el transporte del
      // texto (play, saltos) solo tiene sentido con el prompter en marcha.
      if (state !== 'preview' && state !== 'recording') return;
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      // Las flechas sobre un slider enfocado ya las gestiona el propio slider.
      if (event.target instanceof HTMLElement && event.target.getAttribute('role') === 'slider') return;

      const recording = state === 'recording';

      switch (event.key) {
        case ' ':
          if (!recording) return;
          event.preventDefault();
          prompter.toggle();
          break;
        case 'ArrowUp':
          event.preventDefault();
          prompter.bumpSpeed(SPEED_RANGE.step);
          break;
        case 'ArrowDown':
          event.preventDefault();
          prompter.bumpSpeed(-SPEED_RANGE.step);
          break;
        case 'ArrowLeft':
          if (!recording) return;
          prompter.step(-1);
          break;
        case 'ArrowRight':
          if (!recording) return;
          prompter.step(1);
          break;
        case '+':
          prompter.bumpFontSize(FONT_SIZE_RANGE.step);
          break;
        case '-':
          prompter.bumpFontSize(-FONT_SIZE_RANGE.step);
          break;
        default:
          return;
      }

      syncSliders();
    });

    /* ── Limpieza ────────────────────────────────────────── */

    const cleanup = (): void => {
      prompter.destroy();
      composer?.stop();
      window.clearInterval(timerId);
      pulseTween?.kill();
      stopStream(stream);
      stream = null;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    };

    // `astro:before-swap` cubre la navegación del ClientRouter; `pagehide`, el
    // cierre de pestaña. Sin esto la luz de la cámara se queda encendida.
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    window.addEventListener('pagehide', cleanup, { once: true });

    setState('preview');
  });
</script>
