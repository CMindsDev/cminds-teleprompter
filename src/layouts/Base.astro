---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** `dark` pinta el degradado azul de la portada; `video` deja el fondo negro. */
  theme?: 'light' | 'dark' | 'video';
  /** Bloquea el scroll de la página (pantallas a pantalla completa). */
  lockScroll?: boolean;
}

const {
  title,
  description = 'Dale voz a tus ideas: escribe, lee a tu ritmo y grábate siendo tú.',
  theme = 'light',
  lockScroll = false,
} = Astro.props;

const BODY_THEME = {
  light: 'bg-paper text-ink',
  dark: 'bg-ink text-white',
  video: 'bg-black text-white',
} as const;
---

<!doctype html>
<html lang="es" class={theme === 'light' ? '' : 'dark-surface'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'light' ? '#fafafa' : '#070615'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Permissions-Policy vía <meta>: autoriza cámara y micrófono en este mismo
      origen. Los navegadores lo aplican como refuerzo; la cabecera HTTP
      equivalente está en `public/_headers` y `vercel.json` para producción.
    -->
    <meta http-equiv="Permissions-Policy" content="camera=(self), microphone=(self)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@500;600;700;800&family=Sora:wght@300;400;500;600;700&display=swap"
    />

    <ClientRouter />
  </head>

  <body class:list={[BODY_THEME[theme], lockScroll && 'overflow-hidden']}>
    <slot />

    <!-- Contenedor de avisos flotantes (lo usa `motion.ts › toast`). -->
    <div
      id="toast-host"
      class="pointer-events-none fixed inset-x-0 bottom-32 z-50 flex flex-col items-center gap-2 px-4"
      aria-live="polite"
    >
    </div>

    <script>
      import { initLiquidGlass } from '../lib/liquid-glass/init';
      import { enterScreen, exitScreen } from '../lib/motion';

      // El build guarda la interfaz para próximas visitas sin conexión.
      // Los speeches y videos se guardan aparte, en localStorage e IndexedDB.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        // Si ya había un controlador, esta pestaña está sirviéndose de una
        // versión cacheada. Cuando el worker nuevo tome el relevo hay que
        // recargar: el HTML y los módulos en pantalla son los antiguos y no
        // cambian solos. Sin esto, un despliegue no llega nunca al móvil.
        const teniaControlador = Boolean(navigator.serviceWorker.controller);
        let recargando = false;

        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!teniaControlador || recargando) return;
          recargando = true;
          window.location.reload();
        });

        navigator.serviceWorker
          .register('/sw.js')
          // Fuerza la comprobación de versión al entrar, en vez de esperar a
          // que el navegador decida revisarla por su cuenta.
          .then((registration) => registration.update())
          .catch((error) => {
            console.warn('No se pudo preparar la aplicación sin conexión.', error);
          });
      }

      /**
       * Alto real del viewport.
       *
       * `100vh` en móvil incluye la barra del navegador, y `window.innerHeight`
       * no encoge cuando se abre el teclado. `visualViewport` sí refleja el
       * área realmente visible, que es lo que mantiene el botón del editor por
       * encima del teclado en lugar de debajo.
       */
      function syncViewportHeight(): void {
        const height = window.visualViewport?.height ?? window.innerHeight;
        document.documentElement.style.setProperty('--app-vh', `${height}px`);
      }

      function boot(): void {
        syncViewportHeight();
        void initLiquidGlass();
        enterScreen();
      }

      window.addEventListener('resize', syncViewportHeight);
      window.visualViewport?.addEventListener('resize', syncViewportHeight);
      document.addEventListener('astro:page-load', boot);

      // Salida animada antes de que el ClientRouter cambie de página.
      document.addEventListener('astro:before-preparation', (event) => {
        const navigation = event as Event & { loader: () => Promise<void> };
        const original = navigation.loader;
        navigation.loader = async () => {
          await exitScreen();
          await original();
        };
      });
    </script>
  </body>
</html>
