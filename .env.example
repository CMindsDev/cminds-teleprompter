# ─────────────────────────────────────────────────────────────
# C MINDS Teleprompter — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# Todo lo que empiece con PUBLIC_ queda expuesto al navegador.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (canonical, og:url, CORS)
PUBLIC_SITE_URL="http://localhost:4321"

# ── Almacenamiento de multimedia (bucket) ────────────────────
# Proveedor: "none" | "s3" | "r2" | "supabase" | "gcs"
# Con "none" las grabaciones viven solo en IndexedDB del navegador
# y se descargan localmente (no se sube nada).
PUBLIC_STORAGE_PROVIDER="none"

# Endpoint público de lectura del bucket (CDN o dominio custom)
PUBLIC_STORAGE_PUBLIC_URL=""

# Dominios autorizados para leer/escribir en el bucket (CORS).
# Lista separada por comas, sin slash final. Se consume en
# `src/lib/storage/cors.ts` y en `scripts/apply-bucket-cors.mjs`.
PUBLIC_ALLOWED_ORIGINS="http://localhost:4321,https://teleprompter.cminds.co"

# Límite de subida en MB (validación en cliente antes de subir)
PUBLIC_MAX_UPLOAD_MB="512"

# ── Credenciales del bucket (SOLO servidor, nunca PUBLIC_) ───
# S3 / Cloudflare R2
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""            # p.ej. https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Supabase Storage (alternativa)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="grabaciones"

# Google Cloud Storage (alternativa)
GCS_PROJECT_ID=""
GCS_BUCKET=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""

# Tiempo de vida de las URLs firmadas, en segundos
STORAGE_SIGNED_URL_TTL="900"
